APP_NAME="AISTEL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# DATABASE CONFIGURATION
# Default: MySQL (sesuai PRD 18, Laragon lokal)
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aistell_db
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------
# OPTION B: PostgreSQL (mis. Neon Serverless)
# ------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=aistell_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret
# DB_SSLMODE=prefer

# ------------------------------------------
# OPTION C: SQLite (Quick Local Dev)
# ------------------------------------------
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ------------------------------------------
# Akun admin yang dibuat oleh AdminSeeder
# (ADMIN_PASSWORD wajib diisi di production)
# ------------------------------------------
ADMIN_EMAIL=admin@aistel.test
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database


VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Email (verifikasi akun & reset password). Contoh Gmail: buat "App Password"
# di akun Google (perlu 2-Step Verification), lalu isi di bawah.
# MAIL_MAILER=log hanya menulis email ke storage/logs (tidak terkirim sungguhan).
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Kuota pesanan aktif per tanggal layanan (0 = tanpa batas)
ORDER_DAILY_QUOTA=0

# Keamanan (lihat config/security.php)
ADMIN_IDLE_MINUTES=30
SECURITY_CSP=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_HSTS=true
SECURITY_NOTIFY_NEW_ADMIN_DEVICE=true
