# ==========================================================================
# AISTEL — contoh .env untuk PRODUCTION (server / hosting)
# Salin menjadi `.env` DI SERVER, lalu isi semua nilai bertanda GANTI.
# Jangan commit file `.env` yang sudah berisi password.
# Panduan lengkap: docs/DEPLOY.md
# ==========================================================================

APP_NAME="AISTEL"
APP_ENV=production
APP_DEBUG=false
# Buat dengan: php artisan key:generate --show   (wajib, jangan pakai key lokal)
APP_KEY=GANTI
# Alamat situs, WAJIB diawali https:// (mengaktifkan URL https & cookie aman)
APP_URL=https://GANTI-domain-anda.example
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (MySQL / MariaDB) -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=GANTI
DB_PORT=3306
DB_DATABASE=GANTI
DB_USERNAME=GANTI
DB_PASSWORD=GANTI
# Database cloud yang mewajibkan SSL (mis. TiDB Cloud, Aiven): isi lokasi sertifikat CA, contoh
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Akun admin pertama (dibuat oleh: php artisan db:seed --class=AdminSeeder --force) ---
# Wajib diisi di production. Ganti passwordnya setelah login pertama.
ADMIN_EMAIL=GANTI@email-anda.example
ADMIN_PASSWORD=GANTI-password-kuat-min-12-karakter

# --- Session, cache, queue (semuanya di database, tidak butuh Redis) --------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Di belakang proxy / PaaS / Cloudflare? isi `*` ; hosting biasa & VPS: kosongkan ---
TRUSTED_PROXIES=

# --- Email (wajib agar fitur "Lupa password" benar-benar mengirim email) -----
# Contoh Brevo / Gmail (App Password) / Mailtrap. Jika dibiarkan `log`, email tidak terkirim.
MAIL_MAILER=smtp
MAIL_HOST=GANTI
MAIL_PORT=587
MAIL_USERNAME=GANTI
MAIL_PASSWORD=GANTI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="GANTI@domain-anda.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
